# Vaultwarden host/URL settings
# Use your public URL (including https://) if you run behind reverse proxy.
DOMAIN=http://localhost:8080

# Port to expose Vaultwarden web/API on host machine
VAULTWARDEN_PORT=8080

# Admin panel access URL: /admin
# Generate a strong token before production use.
# Example: openssl rand -base64 48
ADMIN_TOKEN=replace-with-a-strong-random-token

# Recommended production defaults
SIGNUPS_ALLOWED=false
WEBSOCKET_ENABLED=true
LOG_FILE=/data/vaultwarden.log
ROCKET_LOG=critical
